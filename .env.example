# QCDKR 环境变量模板：复制为 .env 后填写，切勿提交真实密钥
# 服务端口与监听地址
QCDKR_3D_PORT=5194
QCDKR_HOST=127.0.0.1

# 公网部署白名单（host:port 与来源，逗号分隔）
QCDKR_SHARE_HOSTS=
QCDKR_SHARE_ORIGINS=

# 设为 1 时按账号隔离运行数据
QCDKR_SCOPED_STATE=1

# AI 通道（OpenAI 兼容）
DKQKAR_LLM_PROVIDER=modelscope
DKQKAR_LLM_ENDPOINT=
DKQKAR_LLM_MODEL=
DKQKAR_LLM_API_KEY=
MODELSCOPE_API_KEY=

# Python 解释器（留空自动探测 model-runtime/）
DKQKAR_PYTHON=
