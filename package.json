{
  "name": "dkqkar-studio",
  "productName": "QCDKR",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/build.mjs",
    "start": "node scripts/run.mjs start",
    "serve": "node scripts/run.mjs serve",
    "test": "node scripts/test.mjs",
    "verify": "node scripts/check-runtime.mjs",
    "app": "node scripts/run.mjs app",
    "package": "node scripts/package.mjs",
    "package:dir": "node scripts/package.mjs --dir",
    "model:setup": "node scripts/check-runtime.mjs",
    "package:competition": "node scripts/package-competition.mjs",
    "package:nsis": "node scripts/package-nsis.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.1.48",
    "@langchain/langgraph": "1.5.2",
    "docx": "^9.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "read-excel-file": "^9.3.10",
    "three": "^0.180.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^7.1.7"
  },
  "main": "desktop/entry.cjs",
  "description": "AI大模型与量子机器学习协同驱动的冷轧轧制力预测云平台",
  "author": "DKQKAR",
  "build": {
    "appId": "com.dkqkar.studio",
    "productName": "QCDKR",
    "executableName": "QCDKR",
    "directories": {
      "output": "rebuild-output",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "src/*.js",
      "src/range-table.json",
      "desktop/**/*",
      "package.json",
      "!dist/competition/**/*",
      "!**/__pycache__/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/**/*",
      "desktop/voice-engine.ps1",
      "server/**/*.py"
    ],
    "extraResources": [
      {
        "from": "model-runtime",
        "to": "model-runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "data/local-llm/runtime",
        "to": "local-llm/runtime",
        "filter": [
          "**/*",
          "!installation.json",
          "!**/*.log",
          "!**/*.zip"
        ]
      },
      {
        "from": "data/local-llm/models",
        "to": "local-llm/models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/app.ico",
      "signExecutable": false
    },
    "nsisWeb": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QCDKR",
      "artifactName": "QCDKR_Competition_Setup.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "packElevateHelper": false,
      "differentialPackage": false,
      "script": "tmp/offline-nsis/installer.nsi",
      "appPackageUrl": "offline://local-payload-only",
      "installerLanguages": [
        "zh_CN"
      ],
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
